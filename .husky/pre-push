#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

npm test # full Jest suite before pushing

# Benchmark smoke test: correctness checks only (no performance benchmarks).
# Verifies build integrity, dev↔prod bit-for-bit match, DCE, and fdlibm determinism.
# Skipped if tools/benchmark/node_modules is not installed.
if [ -d "tools/benchmark/node_modules" ]; then
 npm run tools:bench:smoke
fi
