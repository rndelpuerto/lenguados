{
 "name": "lenguados",
 "description": "[![License](https://img.shields.io/badge/license-Apache--2.0-blue.svg)](LICENSE)   > **2‑D version** of the *Lenguado* physics‑engine family",
 "keywords": [],
 "author": "Ricardo Nicolás del Puerto Camacho",
 "license": "Apache-2.0",
 "type": "module",
 "private": true,
 "workspaces": [
  "packages/*",
  "docs"
 ],
 "scripts": {
  "build": "npm run build:packages",
  "build:bundles": "npm run rollup",
  "build:packages": "npm run build:bundles",
  "clean": "npm run clean:packages && npm run clean:main",
  "clean-install": "npm run clean && npm run init",
  "clean:main": "rm -rf node_modules package-lock.json",
  "clean:packages": "lerna run clean",
  "dist": "npm run build && cross-env NODE_ENV=production npm run dist:packages",
  "dist:bundles": "npm run rollup-dist",
  "dist:packages": "npm run dist:bundles",
  "docs": "npm --workspace docs run build",
  "docs:dev": "npm --workspace docs run start",
  "docs:deploy": "npm --workspace docs run deploy",
  "init": "npm install && pip install -r requirements.txt",
  "prepare": "husky",
  "lint": "npm run lint:js && npm run lint:css",
  "lint:css": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
  "lint:css:fix": "npm run lint:css -- --fix",
  "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
  "lint:js": "eslint .",
  "lint:js:fix": "npm run lint:js -- --fix",
  "format": "prettier --write .",
  "format:check": "prettier --check .",
  "rollup": "cross-env NODE_ENV=development lerna run build",
  "rollup-dist": "cross-env NODE_ENV=production lerna run build",
  "setup": "npm run init && npm run build",
  "pretest": "npm run lint",
  "test": "npm run test:unit",
  "test:unit": "jest --coverage",
  "test:watch": "jest --watch",
  "typecheck": "tsc --noEmit",
  "tools:create-package": "cookiecutter tools/package --overwrite-if-exists --output-dir ./packages",
  "tools:bench": "npm --prefix tools/benchmark run bench --",
  "tools:bench:stress": "npm --prefix tools/benchmark run stress --",
  "tools:bench:dx": "npm --prefix tools/benchmark run dx --",
  "tools:bench:compare": "npm --prefix tools/benchmark run compare --",
  "tools:bench:cross-env": "npm --prefix tools/benchmark run cross-env --",
  "tools:bench:all": "npm --prefix tools/benchmark run run-all",
  "tools:bench:test": "npm --prefix tools/benchmark run test",
  "tools:bench:docs-data": "node scripts/generate-docs-data.mjs",
  "tools:bench:smoke": "npm --prefix tools/benchmark run smoke",
  "tools:bench:setup": "cd tools/benchmark && npm ci",
  "outdated": "npm run outdated:pkgs",
  "outdated:pkgs": "lerna run outdated",
  "prerelease": "npm run clean-install && npm run outdated",
  "version": "lerna version --conventional-commits --yes",
  "version:alpha": "npm run prerelease && lerna version prerelease --conventional-commits --preid alpha --yes --no-changelog",
  "version:beta": "npm run prerelease && lerna version prerelease --conventional-commits --preid beta --yes",
  "watch": "cross-env NODE_ENV=development lerna run watch"
 },
 "husky": {
  "config": "husky.config.js"
 },
 "commitlint": {
  "extends": [
   "@commitlint/config-conventional"
  ]
 },
 "repository": {
  "type": "git",
  "url": "git+https://github.com/rndelpuerto/lenguados.git"
 },
 "bugs": {
  "url": "https://github.com/rndelpuerto/lenguados/issues"
 },
 "homepage": "https://github.com/rndelpuerto/lenguados#readme",
 "engines": {
  "node": "^24.14.0"
 },
 "devDependencies": {
  "@commitlint/cli": "^20.5.0",
  "@commitlint/config-conventional": "^20.5.0",
  "@eslint/js": "^9.39.4",
  "@rollup/plugin-commonjs": "^29.0.2",
  "@rollup/plugin-json": "^6.1.0",
  "@rollup/plugin-node-resolve": "^16.0.3",
  "@rollup/plugin-terser": "^1.0.0",
  "@swc/core": "^1.15.24",
  "@swc/jest": "^0.2.39",
  "@testing-library/jest-dom": "^6.9.1",
  "@types/jest": "^30.0.0",
  "@typescript-eslint/eslint-plugin": "8.58.1",
  "@typescript-eslint/parser": "8.58.1",
  "cross-env": "^10.1.0",
  "eslint": "^9.39.4",
  "eslint-config-prettier": "^10.1.8",
  "eslint-define-config": "^2.1.0",
  "eslint-import-resolver-typescript": "^4.4.4",
  "eslint-plugin-immutable": "^1.0.0",
  "eslint-plugin-import": "^2.32.0",
  "eslint-plugin-jest": "^29.15.1",
  "eslint-plugin-jsdoc": "^62.9.0",
  "eslint-plugin-prettier": "^5.5.5",
  "eslint-plugin-unicorn": "^64.0.0",
  "fast-check": "^4.6.0",
  "fast-glob": "^3.3.3",
  "husky": "^9.1.7",
  "jest": "^30.3.0",
  "jest-canvas-mock": "^2.5.2",
  "jest-environment-jsdom": "^30.3.0",
  "lerna": "^9.0.7",
  "lint-staged": "^16.4.0",
  "prettier": "^3.8.1",
  "rimraf": "^6.1.3",
  "rollup": "^4.60.1",
  "rollup-plugin-copy": "^3.5.0",
  "rollup-plugin-dts": "^6.4.1",
  "rollup-plugin-filesize": "^10.0.0",
  "rollup-plugin-peer-deps-external": "^2.2.4",
  "rollup-plugin-polyfill-node": "^0.13.0",
  "rollup-plugin-swc3": "^0.12.1",
  "rollup-plugin-visualizer": "^7.0.1",
  "stylelint": "^17.6.0",
  "stylelint-config-standard": "^40.0.0",
  "stylelint-order": "^8.1.1",
  "stylelint-prettier": "^5.0.3",
  "ts-node": "^10.9.2",
  "typedoc": "^0.28.18"
 }
}
