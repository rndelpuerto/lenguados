  "tsx": "^4.19.0"
 },
 "devDependencies": {
  "@jest/globals": "^30.3.0",
  "@size-limit/esbuild": "^11.0.0",
  "@swc/core": "^1.15.24",
  "@swc/jest": "^0.2.39",
  "@types/node": "^25.6.0",
  "jest": "^30.3.0",
  "size-limit": "^11.0.0"
 },
