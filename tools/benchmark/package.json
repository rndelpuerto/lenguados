  "dx": "tsx scripts/dx.ts",
  "cross-env": "tsx scripts/cross-env.ts",
  "compare": "tsx scripts/compare.ts",
  "run-all": "tsx scripts/run-all.ts",
  "summarize": "tsx scripts/summarize.ts",
  "smoke": "tsx scripts/smoke.ts",
  "test": "node --experimental-vm-modules ./node_modules/.bin/jest"
 },
 "dependencies": {
  "decimal.js": "^10.4.3",
