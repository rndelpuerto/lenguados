{
 "name": "@lenguados/benchmark",
 "version": "0.0.0",
 "private": true,
 "description": "Scientific benchmarking and stress testing laboratory for @lenguados/math2d",
 "type": "module",
 "engines": {
  "node": ">=24"
 },
 "scripts": {
  "bench": "tsx scripts/bench.ts",
