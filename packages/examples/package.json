{
 "name": "@lenguados/examples",
 "version": "0.6.0",
 "description": "Interactive demos and reference scenes exercising the public API of the 2-D packages of the Lenguado physics-engine family.",
 "keywords": [
  "examples"
 ],
 "homepage": "https://github.com/rndelpuerto/lenguados#readme",
 "bugs": {
  "url": "https://github.com/rndelpuerto/lenguados/issues"
 },
 "repository": {
  "type": "git",
  "url": "git+https://github.com/rndelpuerto/lenguados.git",
  "directory": "packages/examples"
 },
 "license": "Apache-2.0",
 "author": "Ricardo Nicolás del Puerto Camacho",
 "contributors": [
  "Ricardo Nicolás del Puerto Camacho"
 ],
 "main": "./main.js",
 "module": "./main.mjs",
 "browser": {
  "./main.js": "./main.js"
 },
 "types": "./lib/@types/index.d.ts",
 "sideEffects": false,
 "exports": {
  ".": {
   "types": "./lib/@types/index.d.ts",
   "development": {
    "require": "./main.js",
    "import": "./dev-main.mjs"
   },
   "default": {
    "require": "./main.js",
    "import": "./main.mjs"
   }
  },
  "./canvas-hello/*": {
   "types": "./lib/@types/canvas-hello/*.d.ts",
   "development": {
    "require": "./lib/cjs/canvas-hello/*.development.js",
    "import": "./lib/esm/canvas-hello/*.development.js"
   },
   "default": {
    "require": "./lib/cjs/canvas-hello/*.production.js",
    "import": "./lib/esm/canvas-hello/*.production.js"
   }
  },
  "./assets/*": "./lib/assets/*",
  "./lib/*": {
   "require": "./lib/cjs/*",
   "import": "./lib/esm/*"
  },
  "./*": "./*"
 },
 "files": [
  "index.ts",
  "main.js",
  "main.mjs",
  "dev-main.mjs",
  "lib",
  "LICENSE",
  "NOTICE"
 ],
 "scripts": {
  "build": "node ../../scripts/build.mjs",
  "clean": "node ../../scripts/clean.mjs",
  "outdated": "node ../../scripts/outdated.mjs",
  "prepack": "cross-env NODE_ENV=development node ../../scripts/build.mjs && cross-env NODE_ENV=production node ../../scripts/build.mjs && node ../../scripts/sync-legal-files.mjs",
  "publish:local": "node ../../scripts/publish-local.mjs",
  "unpublish:local": "node ../../scripts/unpublish-local.mjs",
  "watch": "node ../../scripts/watch.mjs"
 },
 "engines": {
  "node": ">=24"
 },
 "publishConfig": {
  "access": "public"
 },
 "typedocOptions": {
  "entryPoints": [
   "src/canvas-hello/index.ts"
  ]
 },
 "devDependencies": {
  "@lenguados/math2d": "^0.6.0"
 },
 "config": {
  "verdaccioport": "4873"
 },
 "peerDependencies": {
  "@lenguados/math2d": "^0.6.0"
 },
 "peerDependenciesMeta": {
  "@lenguados/math2d": {
   "optional": true
  }
 }
}
