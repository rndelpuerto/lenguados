-
-  let sum = 0;
-  let compensation = 0;
-
-  for (let index = 0; index < a.length; index++) {
-   const sanitizedA = this.sanitize(a[index]!);
-   const sanitizedB = this.sanitize(b[index]!);
-   const { product, error: productError } = this.twoProduct(sanitizedA, sanitizedB);
