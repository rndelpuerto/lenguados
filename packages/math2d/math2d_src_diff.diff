- TRUNCATE = 'truncate',
- /** Round to nearest, ties to even (banker's rounding) */
- NEAREST_EVEN = 'nearestEven',
- /** Round to nearest, ties away from zero */
- NEAREST_AWAY = 'nearestAway',
- /** Round towards positive infinity (ceil) */
