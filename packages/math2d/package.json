{
 "name": "@lenguados/math2d",
 "version": "0.6.0",
 "description": "Core 2-D math utilities for the Lenguado physics-engine family.",
 "keywords": [
  "math2d"
 ],
 "homepage": "https://github.com/rndelpuerto/lenguados#readme",
 "bugs": {
  "url": "https://github.com/rndelpuerto/lenguados/issues"
 },
 "repository": {
  "type": "git",
  "url": "git+https://github.com/rndelpuerto/lenguados.git",
  "directory": "packages/math2d"
 },
 "license": "Apache-2.0",
 "author": "Ricardo Nicolás del Puerto Camacho",
 "contributors": [
  "Ricardo Nicolás del Puerto Camacho"
 ],
 "main": "./main.js",
 "module": "./main.mjs",
 "browser": {
  "./main.js": "./main.js"
 },
 "types": "./lib/@types/index.d.ts",
 "exports": {
  ".": {
   "types": "./lib/@types/index.d.ts",
   "development": {
    "require": "./main.js",
    "import": "./dev-main.mjs"
   },
   "default": {
    "require": "./main.js",
    "import": "./main.mjs"
   }
  },
  "./validation/assert": {
   "types": "./lib/@types/validation/assert.d.ts",
   "development": {
    "require": "./lib/cjs/validation/assert.development.js",
    "import": "./lib/esm/validation/assert.development.js"
   },
   "default": {
    "require": "./lib/cjs/validation/assert.production.js",
    "import": "./lib/esm/validation/assert.production.js"
   }
  },
  "./deterministic/precision-math": {
   "types": "./lib/@types/deterministic/precision-math.d.ts",
   "development": {
    "require": "./lib/cjs/deterministic/precision-math.development.js",
    "import": "./lib/esm/deterministic/precision-math.development.js"
   },
   "default": {
    "require": "./lib/cjs/deterministic/precision-math.production.js",
    "import": "./lib/esm/deterministic/precision-math.production.js"
   }
  },
  "./deterministic/rounding-control": {
   "types": "./lib/@types/deterministic/rounding-control.d.ts",
   "development": {
    "require": "./lib/cjs/deterministic/rounding-control.development.js",
    "import": "./lib/esm/deterministic/rounding-control.development.js"
   },
   "default": {
    "require": "./lib/cjs/deterministic/rounding-control.production.js",
    "import": "./lib/esm/deterministic/rounding-control.production.js"
   }
  },
  "./utils/random": {
   "types": "./lib/@types/utils/random.d.ts",
   "development": {
    "require": "./lib/cjs/utils/random.development.js",
    "import": "./lib/esm/utils/random.development.js"
   },
   "default": {
    "require": "./lib/cjs/utils/random.production.js",
    "import": "./lib/esm/utils/random.production.js"
   }
  },
  "./utils/random-source": {
   "types": "./lib/@types/utils/random-source.d.ts",
   "development": {
    "require": "./lib/cjs/utils/random-source.development.js",
    "import": "./lib/esm/utils/random-source.development.js"
   },
   "default": {
    "require": "./lib/cjs/utils/random-source.production.js",
    "import": "./lib/esm/utils/random-source.production.js"
   }
  },
  "./utils/parse": {
   "types": "./lib/@types/utils/parse.d.ts",
   "development": {
    "require": "./lib/cjs/utils/parse.development.js",
    "import": "./lib/esm/utils/parse.development.js"
   },
   "default": {
    "require": "./lib/cjs/utils/parse.production.js",
    "import": "./lib/esm/utils/parse.production.js"
   }
  },
  "./utils/performance": {
   "types": "./lib/@types/utils/performance.d.ts",
   "development": {
    "require": "./lib/cjs/utils/performance.development.js",
    "import": "./lib/esm/utils/performance.development.js"
   },
   "default": {
    "require": "./lib/cjs/utils/performance.production.js",
    "import": "./lib/esm/utils/performance.production.js"
   }
  },
  "./lib/*": {
   "types": "./lib/@types/*.d.ts",
   "require": "./lib/cjs/*",
   "import": "./lib/esm/*"
  },
  "./*": "./*"
 },
 "files": [
  "index.ts",
  "main.js",
  "main.mjs",
  "dev-main.mjs",
  "lib"
 ],
 "scripts": {
  "build": "node ../../scripts/build.mjs",
  "clean": "node ../../scripts/clean.mjs",
  "outdated": "node ../../scripts/outdated.mjs",
  "publish:local": "node ../../scripts/publish-local.mjs",
  "unpublish:local": "node ../../scripts/unpublish-local.mjs",
  "watch": "node ../../scripts/watch.mjs"
 },
 "config": {
  "verdaccioport": "4873"
 },
 "engines": {
  "node": ">=22"
 },
 "publishConfig": {
  "access": "public"
 }
}
